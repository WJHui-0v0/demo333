{
    "num_epochs": 3,
    "batch_size": 4,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 1,
    "lr":2e-04,
    "weight_decay": 0.01,
    "device": "cuda:0",
    "model_name": "Qwen2.5-7B",
    "model_dir": "../autodl-tmp/Qwen2.5-7B-Instruct",
    "dropout_rate": 0.2,
    "data_path": "./data/",
    "train_path":"./data/train.json",
    "dev_path":"./data/dev.json",
    "test_path":"./data/test.json",
    "max_length":400,
    "max_new_tokens": 128,
    "eval_max_new_tokens": 128,
    "test_max_new_tokens": 128,
    "eval_batch_size": 4,
    "bf16": true,
    "gradient_checkpointing": false,
    "max_grad_norm": 1.0,
    "log_steps": 10,
    "optim": "adamw_torch",
    "warmup_ratio": 0.03,
    "save_steps": 200,
    "save_total_limit": 3,
    "eval_steps": 200,
    "train_eval_batches": 2,
    "resume_from_checkpoint": null,
    "quick_train_size": 16,
    "quick_dev_size": 8,
    "quick_test_size": 8,
    "patience":10,
    "monitor": "val_f1",
    "delta":0.0001,
    "save_dir": "./checkpoint/",
    "warmup_steps": 100,
    "eps":1e-8,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.1,
    "method": "lora",
    "lora_target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj"
    ],
    "prompt": "你是生物医学命名实体识别专家。从输入句子中提取所有基因实体。每个实体单独一行，格式：实体名:GENE。如果没有基因实体，输出'无实体'。输入句子如下：",
    "template_name": "qwen"
}
