{
    "num_epochs": 3,
    "batch_size": 4,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 1,
    "lr":2e-05,
    "weight_decay": 0.01,
    "device": "cuda:0",
    "model_name": "Qwen2.5-7B",
    "model_dir": "../autodl-tmp/Qwen2.5-7B-Instruct",
    "dropout_rate": 0.2,
    "data_path": "./data/",
    "train_path":"./data/train.json",
    "dev_path":"./data/dev.json",
    "test_path":"./data/test.json",
    "max_length": 400,
    "max_new_tokens": 128,
    "eval_max_new_tokens": 128,
    "test_max_new_tokens": 128,
    "eval_batch_size": 4,
    "bf16": true,
    "gradient_checkpointing": true,
    "max_grad_norm": 1.0,
    "log_steps": 10,
    "optim": "paged_adamw_8bit",
    "quick_train_size": 16,
    "quick_dev_size": 8,
    "quick_test_size": 8,
    "patience":10,
    "monitor": "val_f1",
    "delta":0.0001,
    "save_dir": "./checkpoint/",
    "warmup_steps": 500,
    "eps":1e-8,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "method": "qlora",
    "lora_target_modules": [ 
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj",
        "gate_proj",
        "up_proj",
        "down_proj"
        ],
    "prompt": "You are an expert in biomedical named entity recognition. Your task is to identify gene and protein entities from the given English biomedical text. The entity type is defined as follows: GENE includes gene or protein names, such as gene products, enzymes, receptors, antibodies, cytokines, and similar molecules.Output strictly as JSON: {\"entities\": [{\"name\": \"entity name\", \"type\": \"entity type\"}]}. No extra text. Input:",
    
    "template_name": "qwen"
}
